"""Ticket CRUD: list, retrieve, update, delete, reclassify."""

from datetime import datetime, timezone
from uuid import UUID

from fastapi import APIRouter, Depends, HTTPException, Query, status
from pydantic import BaseModel
from sqlalchemy.orm import Session

from backend.database import get_db
from backend.models import Ticket
from backend.services import classifier

router = APIRouter(prefix="/tickets", tags=["tickets"])


class TicketResponse(BaseModel):
    id: str
    subject: str | None
    body: str
    text: str
    source: str
    language: str | None
    predicted_queue: str
    predicted_sentiment: str
    routed_team: str
    priority: str
    status: str
    source_ref: dict | None
    created_at: datetime
    classified_at: datetime | None


class TicketUpdateRequest(BaseModel):
    status: str | None = None
    priority: str | None = None
    routed_team: str | None = None


class TicketListResponse(BaseModel):
    total: int
    items: list[TicketResponse]


def _ticket_response(ticket: Ticket) -> TicketResponse:
    return TicketResponse(
        id=str(ticket.id),
        subject=ticket.subject,
        body=ticket.body,
        text=ticket.text,
        source=ticket.source,
        language=ticket.language,
        predicted_queue=ticket.predicted_queue,
        predicted_sentiment=ticket.predicted_sentiment,
        routed_team=ticket.routed_team,
        priority=ticket.priority,
        status=ticket.status,
        source_ref=ticket.source_ref,
        created_at=ticket.created_at,
        classified_at=ticket.classified_at,
    )


@router.get("", response_model=TicketListResponse)
def list_tickets(
    db: Session = Depends(get_db),
    status_filter: str | None = Query(default=None, alias="status"),
    queue: str | None = None,
    sentiment: str | None = None,
    priority: str | None = None,
    source: str | None = None,
    limit: int = Query(default=50, ge=1, le=200),
    offset: int = Query(default=0, ge=0),
) -> TicketListResponse:
    query = db.query(Ticket).filter(Ticket.deleted_at.is_(None))

    if status_filter:
        query = query.filter(Ticket.status == status_filter)

    if queue:
        query = query.filter(Ticket.predicted_queue == queue)

    if sentiment:
        query = query.filter(Ticket.predicted_sentiment == sentiment)

    if priority:
        query = query.filter(Ticket.priority == priority)

    if source:
        query = query.filter(Ticket.source == source)

    total = query.count()

    tickets = (
        query.order_by(Ticket.created_at.desc())
        .offset(offset)
        .limit(limit)
        .all()
    )

    return TicketListResponse(
        total=total,
        items=[_ticket_response(ticket) for ticket in tickets],
    )


@router.get("/{ticket_id}", response_model=TicketResponse)
def get_ticket(
    ticket_id: UUID,
    db: Session = Depends(get_db),
) -> TicketResponse:
    ticket = (
        db.query(Ticket)
        .filter(
            Ticket.id == ticket_id,
            Ticket.deleted_at.is_(None),
        )
        .first()
    )

    if ticket is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Ticket not found",
        )

    return _ticket_response(ticket)


@router.patch("/{ticket_id}", response_model=TicketResponse)
def update_ticket(
    ticket_id: UUID,
    payload: TicketUpdateRequest,
    db: Session = Depends(get_db),
) -> TicketResponse:
    ticket = (
        db.query(Ticket)
        .filter(
            Ticket.id == ticket_id,
            Ticket.deleted_at.is_(None),
        )
        .first()
    )

    if ticket is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Ticket not found",
        )
    if payload.status is not None:
    print("DEBUG payload.status:", repr(payload.status))
    print("DEBUG status type:", type(payload.status))

    if payload.status not in {
        "open",
        "in_progress",
        "resolved",
    }:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail="Invalid ticket status",
            )
        ticket.status = payload.status

    if payload.priority is not None:
        if payload.priority not in {"normal", "urgent"}:
            raise HTTPException(
              status_code=status.HTTP_400_BAD_REQUEST,
                detail="Invalid ticket priority",
            )
        ticket.priority = payload.priority

    if payload.routed_team is not None:
        ticket.routed_team = payload.routed_team

    db.commit()
    db.refresh(ticket)

    return _ticket_response(ticket)


@router.delete("/{ticket_id}")
def delete_ticket(
    ticket_id: UUID,
    db: Session = Depends(get_db),
) -> dict:
    ticket = (
        db.query(Ticket)
        .filter(
            Ticket.id == ticket_id,
            Ticket.deleted_at.is_(None),
        )
        .first()
    )

    if ticket is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Ticket not found",
        )

    ticket.deleted_at = datetime.now(timezone.utc)

    db.commit()

    return {
        "message": "Ticket deleted successfully",
        "ticket_id": str(ticket.id),
    }


@router.post("/{ticket_id}/reclassify", response_model=TicketResponse)
def reclassify_ticket(
    ticket_id: UUID,
    db: Session = Depends(get_db),
) -> TicketResponse:
    ticket = (
        db.query(Ticket)
        .filter(
            Ticket.id == ticket_id,
            Ticket.deleted_at.is_(None),
        )
        .first()
    )

    if ticket is None:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail="Ticket not found",
        )

    result = classifier.classify(
        subject=ticket.subject,
        body=ticket.body,
        language=ticket.language,
    )

    ticket.predicted_queue = result["predicted_queue"]
    ticket.predicted_sentiment = result["predicted_sentiment"]
    ticket.routed_team = result["routed_team"]
    ticket.priority = result["priority"]
    ticket.classified_at = datetime.now(timezone.utc)

    db.commit()
    db.refresh(ticket)

    return _ticket_response(ticket)











# """Ticket CRUD: list, retrieve, update, delete, reclassify."""



# Copy to .env and replace the passwords. .env is gitignored.
#   cp .env.example .env

POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=Racheldev123
POSTGRES_DB=tickets

# Application role created by docker/initdb/01-app-user.sh on first start.
POSTGRES_USER=tag_app
POSTGRES_PASSWORD=Racheldev123

# 5433 on the host: a local PostgreSQL install usually holds 5432.
DB_HOST_PORT=5433

DATABASE_URL=postgresql+psycopg2://tag_app:Racheldev123@localhost:5433/tickets

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
